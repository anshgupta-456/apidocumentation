# Copy to .env and adjust. Every value is optional.

# PostgreSQL in production. Leave empty to use a local SQLite file (api_validator.db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_validator

# Groq key for AI explanations. Without it the built-in rule-based engine is used.
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_ENABLED=true

# Only requests whose path starts with one of these prefixes are captured (comma separated).
LOG_INCLUDE_PREFIXES=/api/
LOG_MAX_BODY_BYTES=65536

# Number of most recent samples used to infer an endpoint's runtime schema.
INFERENCE_SAMPLE_LIMIT=500

# Where "Apply patch" writes the patched OpenAPI document.
GENERATED_SPEC_PATH=openapi.generated.json

# Comma separated list of origins allowed to call the API from a browser (optional).
CORS_ORIGINS=
