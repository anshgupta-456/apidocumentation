# Copy to .env for local development and adjust. When hosting, set these in your
# platform's environment settings instead (see DEPLOYMENT.md).

# --- Database -----------------------------------------------------------------
# PostgreSQL when hosting (postgres:// and postgresql:// both work).
# Leave empty locally to use a SQLite file (api_validator.db).
DATABASE_URL=

# --- Security (required when the app is reachable from the internet) -----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string used to sign session cookies, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=
# Optional key for scripts / CI: send it as `X-API-Key: <key>`
ADMIN_API_KEY=
SESSION_HOURS=168

# --- AI explanations (optional) ---------------------------------------------------
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_ENABLED=true

# --- Traffic capture ---------------------------------------------------------------
LOG_INCLUDE_PREFIXES=/api/
LOG_MAX_BODY_BYTES=65536
LOG_RETENTION_DAYS=30
REDACT_FIELDS=password,passwd,secret,token,access_token,refresh_token,api_key,apikey,authorization,credit_card,card_number,cvv,ssn
INFERENCE_SAMPLE_LIMIT=500

# --- Automation & alerts -----------------------------------------------------------
AUTO_SCAN_INTERVAL_MINUTES=0
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=high
PUBLIC_BASE_URL=

# --- Keep-alive (free hosting tiers sleep when idle) ------------------------------------
# Defaults to RENDER_EXTERNAL_URL on Render. Leave empty locally.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MINUTES=10

# --- Misc ------------------------------------------------------------------------------
DEMO_ENABLED=true
GENERATED_SPEC_PATH=openapi.generated.json
CORS_ORIGINS=
